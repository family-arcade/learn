---
// Diagrams for the guide, drawn inline so nothing loads
// from elsewhere and they follow the site's light and dark themes. Narrow on
// purpose (360 wide) so the text stays readable on a phone. Every word comes
// from src/content/i18n/en.json (learn.diagram*).
interface Props {
	which: 'parts' | 'together' | 'friend' | 'build' | 'blender';
}
const { which } = Astro.props;
const t = Astro.locals.t;
---

{
	which === 'blender' ? (
		<figure class="fa-diagram tall">
			<svg viewBox="0 0 360 416" role="img" aria-labelledby="dbl-t dbl-d">
				<title id="dbl-t">{t('learn.diagramBlender.title')}</title>
				<desc id="dbl-d">{t('learn.diagramBlender.description')}</desc>
				<defs>
					<marker id="dbl-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
						<path d="M0,0 L10,5 L0,10 z" class="head" />
					</marker>
				</defs>

				<rect x="14" y="4" width="332" height="292" rx="16" class="group" />
				<text x="180" y="26" class="l">{t('learn.diagramBlender.group')}</text>

				<rect x="40" y="38" width="280" height="56" rx="12" class="box you" />
				<text x="180" y="61" class="t">{t('learn.diagramBlender.claudeCode.title')}</text>
				<text x="180" y="81" class="s">{t('learn.diagramBlender.claudeCode.note')}</text>

				<path d="M180,97 L180,125" class="line" marker-end="url(#dbl-arrow)" marker-start="url(#dbl-arrow)" />

				<rect x="40" y="128" width="280" height="56" rx="12" class="box" />
				<text x="180" y="151" class="t">{t('learn.diagramBlender.script.title')}</text>
				<text x="180" y="171" class="s">{t('learn.diagramBlender.script.note')}</text>

				<path d="M180,187 L180,215" class="line" marker-end="url(#dbl-arrow)" marker-start="url(#dbl-arrow)" />

				<rect x="40" y="218" width="280" height="56" rx="12" class="box you" />
				<text x="180" y="241" class="t">{t('learn.diagramBlender.blender.title')}</text>
				<text x="180" y="261" class="s">{t('learn.diagramBlender.blender.note')}</text>

				<rect x="40" y="320" width="280" height="56" rx="12" class="box" />
				<text x="180" y="343" class="t">{t('learn.diagramBlender.web.title')}</text>
				<text x="180" y="363" class="s">{t('learn.diagramBlender.web.note')}</text>
				<text x="180" y="404" class="l">{t('learn.diagramBlender.caption')}</text>
			</svg>
		</figure>
	) : which === 'build' ? (
		<figure class="fa-diagram tall">
			<svg viewBox="0 0 360 512" role="img" aria-labelledby="db-t db-d">
				<title id="db-t">{t('learn.diagramBuild.title')}</title>
				<desc id="db-d">{t('learn.diagramBuild.description')}</desc>
				<defs>
					<marker id="db-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
						<path d="M0,0 L10,5 L0,10 z" class="head" />
					</marker>
				</defs>

				<rect x="40" y="4" width="280" height="46" rx="12" class="box" />
				<text x="180" y="24" class="t">{t('learn.diagramBuild.repository.title')}</text>
				<text x="180" y="42" class="s">{t('learn.diagramBuild.repository.note')}</text>

				<path d="M180,52 L180,71" class="line" marker-end="url(#db-arrow)" />

				<rect x="14" y="74" width="332" height="224" rx="16" class="group" />
				<text x="180" y="94" class="l">{t('learn.diagramBuild.group')}</text>

				<rect x="40" y="104" width="280" height="46" rx="12" class="box" />
				<text x="180" y="124" class="t">{t('learn.diagramBuild.branch.title')}</text>
				<text x="180" y="142" class="s">{t('learn.diagramBuild.branch.note')}</text>

				<path d="M180,152 L180,169" class="line" marker-end="url(#db-arrow)" />

				<rect x="40" y="172" width="280" height="46" rx="12" class="box" />
				<text x="180" y="192" class="t">{t('learn.diagramBuild.look.title')}</text>
				<text x="180" y="210" class="s">{t('learn.diagramBuild.look.note')}</text>

				<path d="M180,220 L180,237" class="line" marker-end="url(#db-arrow)" />

				<rect x="40" y="240" width="280" height="46" rx="12" class="box" />
				<text x="180" y="260" class="t">{t('learn.diagramBuild.pullRequest.title')}</text>
				<text x="180" y="278" class="s">{t('learn.diagramBuild.pullRequest.note')}</text>

				<path d="M180,300 L180,319" class="line" marker-end="url(#db-arrow)" />

				<rect x="40" y="322" width="280" height="46" rx="12" class="box you" />
				<text x="180" y="342" class="t">{t('learn.diagramBuild.merge.title')}</text>
				<text x="180" y="360" class="s">{t('learn.diagramBuild.merge.note')}</text>

				<path d="M180,370 L180,389" class="line" marker-end="url(#db-arrow)" />
				<text x="192" y="385" class="l" style="text-anchor: start">{t('learn.diagramBuild.mergeArrow')}</text>

				<rect x="40" y="392" width="280" height="46" rx="12" class="box" />
				<text x="180" y="412" class="t">{t('learn.diagramBuild.publish.title')}</text>
				<text x="180" y="430" class="s">{t('learn.diagramBuild.publish.note')}</text>

				<path d="M180,440 L180,459" class="line" marker-end="url(#db-arrow)" />

				<rect x="40" y="462" width="280" height="46" rx="12" class="box you" />
				<text x="180" y="482" class="t">{t('learn.diagramBuild.live.title')}</text>
				<text x="180" y="500" class="s">{t('learn.diagramBuild.live.note')}</text>
			</svg>
		</figure>
	) : which === 'parts' ? (
		<figure class="fa-diagram">
			<svg viewBox="0 0 360 286" role="img" aria-labelledby="dp-t dp-d">
				<title id="dp-t">{t('learn.diagramParts.title')}</title>
				<desc id="dp-d">{t('learn.diagramParts.description')}</desc>
				<defs>
					<marker id="dp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
						<path d="M0,0 L10,5 L0,10 z" class="head" />
					</marker>
				</defs>

				<rect x="60" y="6" width="240" height="86" rx="12" class="box" />
				<text x="180" y="34" class="t">{t('learn.diagramParts.server.title')}</text>
				<text x="180" y="56" class="s">{t('learn.diagramParts.server.noteOne')}</text>
				<text x="180" y="76" class="s">{t('learn.diagramParts.server.noteTwo')}</text>

				<path d="M180,96 L180,160" class="line" marker-end="url(#dp-arrow)" />
				<text x="192" y="134" class="l" style="text-anchor: start">{t('learn.diagramParts.arrow')}</text>

				<rect x="40" y="166" width="280" height="112" rx="14" class="box you" />
				<text x="180" y="196" class="t">{t('learn.diagramParts.device.title')}</text>
				<text x="180" y="222" class="s">{t('learn.diagramParts.device.noteOne')}</text>
				<text x="180" y="242" class="s">{t('learn.diagramParts.device.noteTwo')}</text>
				<text x="180" y="264" class="s dim">{t('learn.diagramParts.device.noteThree')}</text>
			</svg>
		</figure>
	) : which === 'friend' ? (
		<figure class="fa-diagram">
			<svg viewBox="0 0 360 290" role="img" aria-labelledby="df-t df-d">
				<title id="df-t">{t('learn.diagramFriend.title')}</title>
				<desc id="df-d">{t('learn.diagramFriend.description')}</desc>
				<defs>
					<marker id="df-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
						<path d="M0,0 L10,5 L0,10 z" class="head" />
					</marker>
				</defs>

				<rect x="40" y="6" width="280" height="86" rx="12" class="box you" />
				<text x="180" y="34" class="t">{t('learn.diagramFriend.arcade.title')}</text>
				<text x="180" y="56" class="s">{t('learn.diagramFriend.arcade.noteOne')}</text>
				<text x="180" y="76" class="s">{t('learn.diagramFriend.arcade.noteTwo')}</text>

				<path d="M140,96 L140,190" class="line" marker-end="url(#df-arrow)" />
				<text x="128" y="134" class="l" style="text-anchor: end">{t('learn.diagramFriend.opensLineOne')}</text>
				<text x="128" y="154" class="l" style="text-anchor: end">{t('learn.diagramFriend.opensLineTwo')}</text>
				<path d="M220,190 L220,96" class="line dashed" marker-end="url(#df-arrow)" />
				<text x="232" y="144" class="l" style="text-anchor: start">{t('learn.diagramFriend.back')}</text>

				<rect x="40" y="196" width="280" height="86" rx="12" class="box" />
				<text x="180" y="224" class="t">{t('learn.diagramFriend.game.title')}</text>
				<text x="180" y="246" class="s">{t('learn.diagramFriend.game.noteOne')}</text>
				<text x="180" y="266" class="s">{t('learn.diagramFriend.game.noteTwo')}</text>
			</svg>
		</figure>
	) : (
		<figure class="fa-diagram">
			<svg viewBox="0 0 360 300" role="img" aria-labelledby="dt-t dt-d">
				<title id="dt-t">{t('learn.diagramTogether.title')}</title>
				<desc id="dt-d">{t('learn.diagramTogether.description')}</desc>
				<defs>
					<marker id="dt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
						<path d="M0,0 L10,5 L0,10 z" class="head" />
					</marker>
				</defs>

				<rect x="45" y="6" width="270" height="86" rx="12" class="box" />
				<text x="180" y="34" class="t">{t('learn.diagramTogether.service.title')}</text>
				<text x="180" y="56" class="s">{t('learn.diagramTogether.service.noteOne')}</text>
				<text x="180" y="76" class="s">{t('learn.diagramTogether.service.noteTwo')}</text>

				<path d="M118,96 L70,180" class="line dashed" marker-end="url(#dt-arrow)" marker-start="url(#dt-arrow)" />
				<path d="M242,96 L290,180" class="line dashed" marker-end="url(#dt-arrow)" marker-start="url(#dt-arrow)" />
				<text x="180" y="132" class="l">{t('learn.diagramTogether.hello')}</text>

				<rect x="6" y="184" width="132" height="76" rx="12" class="box you" />
				<text x="72" y="214" class="t">{t('learn.diagramTogether.you.title')}</text>
				<text x="72" y="238" class="s">{t('learn.diagramTogether.you.note')}</text>

				<rect x="222" y="184" width="132" height="76" rx="12" class="box you" />
				<text x="288" y="214" class="t">{t('learn.diagramTogether.cousin.title')}</text>
				<text x="288" y="238" class="s">{t('learn.diagramTogether.cousin.note')}</text>

				<path d="M144,222 L216,222" class="line strong" marker-end="url(#dt-arrow)" marker-start="url(#dt-arrow)" />
				<text x="180" y="286" class="l">{t('learn.diagramTogether.caption')}</text>
			</svg>
		</figure>
	)
}

<style>
	.fa-diagram {
		margin: 1.5rem auto;
		max-width: 460px;
	}
	.fa-diagram.tall {
		max-width: 400px;
	}
	.group {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 1.5;
		stroke-dasharray: 6 5;
	}
	.fa-diagram svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.box {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-4);
		stroke-width: 1.5;
	}
	.you {
		stroke: #ffd76a;
		stroke-width: 2.5;
	}
	/* Gold on the light page needs more weight to stand out (3:1 or more). */
	:global(:root[data-theme='light']) .you {
		stroke: #a87400;
	}
	text {
		text-anchor: middle;
		font-family: var(--sl-font);
	}
	.t {
		fill: var(--sl-color-white);
		font-size: 16px;
		font-weight: 700;
	}
	.s {
		fill: var(--sl-color-gray-2);
		font-size: 14px;
	}
	.dim {
		fill: var(--sl-color-gray-3);
	}
	.l {
		fill: var(--sl-color-text-accent);
		font-size: 14px;
		font-weight: 600;
	}
	.line {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 2;
	}
	.dashed {
		stroke-dasharray: 5 5;
	}
	.strong {
		stroke-width: 4;
	}
	.head {
		fill: var(--sl-color-text-accent);
	}
</style>
