---
// The page's one main call to action: the hero's yellow pill (Hero.astro),
// centred, with a short line under it.
//
//   <Cta href="/make/" note="…">Make your first game</Cta>
interface Props {
	href: string;
	note?: string;
}
const { href, note } = Astro.props;
---

<div class="fa-cta not-content">
	<a class="fa-cta-pill" href={href}>
		<span><slot /></span>
		<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
			<path d="m9 5 7 7-7 7" />
		</svg>
	</a>
	{note && <p>{note}</p>}
</div>

<style>
	.fa-cta {
		--ink: #2a1f4a;
		--pill-drop: #05070f;
		--ring: #ffe066;
		display: grid;
		justify-items: center;
		gap: 0.9rem;
		margin: 2.25rem 0 0.5rem;
		text-align: center;
	}
	:global(:root[data-theme='light']) .fa-cta {
		--pill-drop: var(--ink);
		--ring: #6a2ee0;
	}
	.fa-cta-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-height: 60px;
		padding: 0 30px;
		border-radius: 999px;
		font-family: var(--fa-round);
		font-weight: 900;
		font-size: 20px;
		line-height: 1.1;
		text-decoration: none;
		white-space: nowrap;
		color: var(--ink);
		border: 1.5px solid var(--ink);
		background: linear-gradient(180deg, #ffe98a, #ffd23f 55%, #f0a800);
		box-shadow:
			inset 0 2px 0 rgba(255, 255, 255, 0.7),
			0 4px 0 var(--pill-drop);
	}
	.fa-cta-pill:hover {
		color: var(--ink);
		background: linear-gradient(180deg, #fff3b0, #ffdf66 55%, #f5b400);
	}
	.fa-cta-pill:focus-visible {
		outline: 4px solid var(--ring);
		outline-offset: 3px;
	}
	.fa-cta-pill svg {
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.fa-cta p {
		margin: 0;
		max-width: 30rem;
		font-size: 1rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	@media (prefers-reduced-motion: no-preference) {
		.fa-cta-pill {
			transition:
				transform 120ms ease-out,
				box-shadow 120ms ease-out;
		}
		.fa-cta-pill:hover {
			transform: translateY(-2px);
		}
		.fa-cta-pill:active {
			transform: translateY(3px);
			box-shadow:
				inset 0 2px 0 rgba(255, 255, 255, 0.7),
				0 1px 0 var(--pill-drop);
		}
	}
</style>
