---
// Starlight's sidebar, with the current page's sections listed under it.
// This replaces the right-hand "On this page" column (see PageSidebar.astro
// and TwoColumnContent.astro, which leave it out).
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarList from './SidebarList.astro';

const { sidebar, toc } = Astro.locals.starlightRoute;
// The first item is Starlight's "Overview" link to the top of the page.
const sections = (toc?.items ?? []).filter((item) => item.slug !== '_top');
---

<SidebarPersister>
	<SidebarList sublist={sidebar} sections={sections} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
