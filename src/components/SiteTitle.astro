---
const base = import.meta.env.BASE_URL;
---
<a href={base} class="fa-logo" aria-label="Family Arcade, home">
  <svg class="fa-star" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="M12 1.8l3 6.3 6.9.9-5 4.8 1.3 6.8L12 17.2l-6.2 3.4 1.3-6.8-5-4.8 6.9-.9z" fill="#ffd76a" stroke="#2a1f4a" stroke-width="1.2" stroke-linejoin="round"/>
  </svg>
  <span class="fa-words">Family Arcade</span>
</a>
<style>
  .fa-logo { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--sl-color-white); }
  .fa-words { font-family: var(--fa-round); font-weight: 900; font-size: 1.25rem; letter-spacing: 0.01em; line-height: 1; }
  .fa-star { flex: none; filter: drop-shadow(0 0 6px rgba(255, 215, 106, 0.55)); }
</style>
